{
  "name": "fantasy-draft-machine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @fdm/web dev",
    "dev:socket": "pnpm --filter @fdm/socket-server dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
