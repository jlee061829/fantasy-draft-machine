{
  "name": "@fdm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support/db.d.ts",
      "import": "./dist/test-support/db.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm run build",
    "test": "env -u DATABASE_URL node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "@fdm/shared": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "prisma": "7.9.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
