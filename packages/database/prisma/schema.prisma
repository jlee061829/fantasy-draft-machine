generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScoringFormat {
  STANDARD
  PPR
  HALF_PPR
}

enum DraftType {
  SNAKE
  LINEAR
}

enum DraftStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETE
}

// Phase 5.1: distinguishes a real authenticated participant from a
// server-owned bot participant. See LeagueMember below for the full
// HUMAN/BOT shape invariant.
enum LeagueMemberType {
  HUMAN
  BOT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified DateTime?
  image         String?

  accounts          Account[]
  sessions          Session[]
  ownedLeagues      League[]
  leagueMemberships LeagueMember[]
  chatMessages      ChatMessage[]
  socketTickets     SocketTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model League {
  id            String        @id @default(cuid())
  name          String
  ownerId       String
  rosterSize    Int
  teamCount     Int
  inviteCode    String        @unique
  timerSeconds  Int
  scoringFormat ScoringFormat
  draftType     DraftType

  owner   User           @relation(fields: [ownerId], references: [id])
  members LeagueMember[]
  draft   Draft?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 5.1: the unified draft-participant model for both humans and
// server-owned bots. draftSlot already meant "who occupies this draft
// position" before bots existed, so a bot is represented as another
// LeagueMember row rather than introducing a second slot-ownership table.
//
// Exactly one of two shapes is valid, enforced by a CHECK constraint added
// by hand in this feature's migration SQL (Prisma 7.9.1 has no `@@check`
// schema DSL, confirmed via `prisma validate` against a scratch schema
// before writing this) — so this invariant is NOT visible here and must be
// preserved manually if this model is touched by a future `prisma migrate
// dev` that doesn't know about it:
//
//   HUMAN: userId IS NOT NULL, displayName IS NULL
//   BOT:   userId IS NULL,     displayName IS NOT NULL
//
// A bot's durable identity is its own LeagueMember.id — there is no fake
// User/Account/Session/SocketTicket row for a bot ever, by design.
//
// @@unique([leagueId, userId]) still rejects a human joining twice. For BOT
// rows (userId = null), PostgreSQL's standard (not version-gated) behavior
// treats every NULL as distinct in a unique index, so multiple bots per
// league coexist under this same constraint with no NULLS NOT DISTINCT
// opt-in or partial index — verified with a real-Postgres integration test
// rather than assumed.
model LeagueMember {
  id              String           @id @default(cuid())
  leagueId        String
  userId          String?
  draftSlot       Int
  participantType LeagueMemberType @default(HUMAN)
  displayName     String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Back-relations for Draft.currentMember/Pick.leagueMember below — see
  // those models' own comments for the onDelete reasoning on each side.
  currentTurnDrafts Draft[]
  picks             Pick[]

  @@unique([leagueId, userId])
  @@unique([leagueId, draftSlot])
}

model Player {
  id           String  @id @default(cuid())
  sleeperId    String  @unique
  fullName     String
  position     String
  nflTeam      String?
  searchRank   Int?
  injuryStatus String?

  adp   PlayerAdp[]
  picks Pick[]
}

model PlayerAdp {
  id       String        @id @default(cuid())
  playerId String
  format   ScoringFormat
  adp      Float?
  source   String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, format])
}

model Draft {
  id                String      @id @default(cuid())
  leagueId          String      @unique
  status            DraftStatus @default(PENDING)
  currentPickNumber Int         @default(1)
  // Phase 5.1: the participant currently on the clock, identified by
  // LeagueMember.id rather than User.id — a bot has no User row to point
  // to. Renamed from currentUserId; see submit-pick.ts/autopick.ts for the
  // read/write sites and this feature's migration for the backfill.
  currentMemberId   String?
  turnDeadline      DateTime?

  league        League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  // SetNull, not Restrict: this is a live "who's on the clock right now"
  // pointer, not historical attribution (that's Pick.leagueMember below).
  // If the referenced LeagueMember row were ever removed, clearing this
  // field is harmless/recoverable — unlike losing a Pick's authorship.
  currentMember LeagueMember? @relation(fields: [currentMemberId], references: [id], onDelete: SetNull)

  picks        Pick[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pick {
  id             String   @id @default(cuid())
  draftId        String
  pickNumber     Int
  // Phase 5.1: renamed from userId. Historical pick attribution now points
  // at the LeagueMember that made the pick (HUMAN or BOT) rather than at a
  // User row a bot could never have. Required (not nullable) — every Pick
  // has exactly one attributable participant.
  leagueMemberId String
  playerId       String
  wasAutopick    Boolean  @default(false)
  createdAt      DateTime @default(now())

  draft        Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  // Restrict, deliberately not Cascade: this is the historical-attribution
  // FK the whole migration exists to protect. A required relation defaults
  // to Restrict in Prisma/Postgres already, but it's declared explicitly
  // here since it's the load-bearing decision — deleting a LeagueMember
  // (e.g. via the existing User -> LeagueMember onDelete: Cascade, if that
  // user has ever picked) must fail loudly at the database level rather
  // than silently erasing that user's/bot's Pick history.
  leagueMember LeagueMember @relation(fields: [leagueMemberId], references: [id], onDelete: Restrict)
  player       Player       @relation(fields: [playerId], references: [id])

  @@unique([draftId, playerId])
  @@unique([draftId, pickNumber])
}

// Short-lived, single-use credential minted by an authenticated Next.js
// route and consumed by the socket server at handshake time to resolve a
// userId, without ever handing the browser the real Auth.js session token.
// See packages/database/src/auth/socket-ticket.ts.
model SocketTicket {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  draftId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}
